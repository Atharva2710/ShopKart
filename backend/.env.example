# Server Port
PORT=8085

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Atlas URI)
dbUrl=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopKart?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens
jwt_secret=your_super_secret_jwt_key_here

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Frontend URL (For Production CORS)
FRONTEND_URL=http://localhost:5173
